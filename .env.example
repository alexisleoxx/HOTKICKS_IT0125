# Copy this file to .env and fill in your keys. Never commit .env.
# These are read by the Node server only. They are never sent to the browser.

PORT=4000

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key (server-side only). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where links in confirmation / password-reset emails send people back to
SITE_URL=http://localhost:5173
